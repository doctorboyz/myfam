# === Database ===
POSTGRES_PASSWORD=your_strong_password_here

# === Local Development ===
# DATABASE_URL="postgresql://root:rootpassword@localhost:5432/myfamdb"

# === Ollama Cloud AI ===
OLLAMA_API_KEY=your_ollama_cloud_api_key_here
# Optional: override endpoint (default https://api.ollama.com)
# OLLAMA_BASE_URL=https://api.ollama.com

# === Per-Intent Model Config (format: ollama:<model>) ===
AI_RESPONSE_MODEL=ollama:qwen3:32b
AI_INTENT_MODEL=ollama:qwen3:32b
AI_EXTRACT_TEXT_MODEL=ollama:qwen3:32b
AI_EXTRACT_SLIP_MODEL=ollama:qwen3:32b

# === App ===
NEXT_PUBLIC_APP_URL=https://myfam.doctorboyz.com